# Copy this file to `.env` and fill in your values.
# Bun auto-loads `.env` from the working directory, so `bun dist/bundle.js`
# picks these up automatically — no need to export shell vars.

# Required: an Anthropic-compatible API key. This example uses OpenRouter.
ANTHROPIC_API_KEY=your-key-here

# Required for non-Anthropic endpoints: the base URL.
ANTHROPIC_BASE_URL=https://openrouter.ai/api

# Optional: override the default models. With OpenRouter you can use any
# model it serves, e.g. z-ai/glm-5.2.
ANTHROPIC_DEFAULT_SONNET_MODEL=z-ai/glm-5.2
ANTHROPIC_DEFAULT_OPUS_MODEL=z-ai/glm-5.2
ANTHROPIC_DEFAULT_HAIKU_MODEL=z-ai/glm-5.2
ANTHROPIC_DEFAULT_MODEL=z-ai/glm-5.2
