# Copy this file to `.env` and fill in your values.
# Bun auto-loads `.env` from the working directory, so `bun dist/bundle.js`
# picks these up automatically — no need to export shell vars.
# The FORGE_* names are mapped to the ANTHROPIC_* names the CLI reads internally
# at startup, so you can use either set (FORGE_* is the Forge-branded alias).

# Required: an Anthropic-compatible API key. This example uses OpenRouter.
FORGE_API_KEY=your-key-here

# Required for non-Anthropic endpoints: the base URL.
FORGE_BASE_URL=https://openrouter.ai/api

# Optional: override the default models. With OpenRouter you can use any
# model it serves, e.g. z-ai/glm-5.2.
FORGE_DEFAULT_SONNET_MODEL=z-ai/glm-5.2
FORGE_DEFAULT_OPUS_MODEL=z-ai/glm-5.2
FORGE_DEFAULT_HAIKU_MODEL=z-ai/glm-5.2
FORGE_DEFAULT_MODEL=z-ai/glm-5.2
